---
layout: layouts/base.njk
title: Posts
description: Posts archive for Alan Wang, browsable by section, domain, and topic.
navKey: posts
---
<div class="layout-grid">
    <aside class="identity-rail topic-rail" id="topic-rail">
        <button type="button" class="topic-rail-toggle" data-topic-toggle aria-expanded="false" aria-controls="topic-rail">Browse by topic</button>
        {% include "partials/post-index-tree.njk" %}
    </aside>

    <main class="content-column">
        <section class="lead-panel lead-panel-archive">
            <h1 class="lead-title" data-posts-title>{{ site.postsPageIntroTitle }}</h1>
            <p class="lead-copy" data-posts-copy>{{ site.postsPageIntroText }}</p>
        </section>

        <section class="content-section content-section-archive">
            <div class="list-stream">
                {% for post in collections.postsDesc %}
                    <article class="stream-item post-item"
                             data-category="{{ post.data.category }}"
                             data-subcategory="{{ post.data.subcategory }}"
                             data-topic="{{ post.data.topic or '' }}">
                        <div class="stream-copy">
                            <div class="stream-meta">
                                <span class="stream-topic">{{ post.data.category }}</span>
                                <span class="stream-subtopic">{{ post.data.subcategory }}</span>
                                {% if post.data.topic %}
                                    <span class="stream-subtopic">{{ post.data.topic }}</span>
                                {% endif %}
                                <span class="stream-date">{{ post.date | displayDate }}</span>
                            </div>
                            <h2 class="stream-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                            <p class="stream-excerpt">{{ post.data.excerpt }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>
            <div class="show-more" hidden>
                <button type="button" class="show-more-button" data-show-more></button>
            </div>
        </section>

        {% include "partials/site-footer.njk" %}
    </main>
</div>
<script>
    (() => {
        const posts = Array.from(document.querySelectorAll(".post-item"));
        const tree = document.querySelector(".topic-rail .post-index-tree");
        const allLink = tree.querySelector("[data-index-all]");
        const groups = Array.from(tree.querySelectorAll("details[data-index-key]"));
        const title = document.querySelector("[data-posts-title]");
        const copy = document.querySelector("[data-posts-copy]");
        const defaultTitle = title.textContent;
        const defaultCopy = copy.textContent;
        const showMore = document.querySelector(".show-more");
        const showMoreButton = document.querySelector("[data-show-more]");
        const rail = document.getElementById("topic-rail");
        const railToggle = document.querySelector("[data-topic-toggle]");
        const levels = ["category", "subcategory", "topic"];
        const pageSize = 10;
        let limit = pageSize;

        // The filter lives in the URL (?category=…&subcategory=…&topic=…) and maps
        // to a tree key like "Knowledge/AI/LLM".
        const readKey = () => {
            const params = new URLSearchParams(location.search);
            const parts = [];
            for (const level of levels) {
                const value = params.get(level);
                if (!value) break;
                parts.push(value);
            }
            return parts.join("/");
        };

        const urlFor = (key) => {
            if (!key) return "/posts/";
            const params = new URLSearchParams();
            key.split("/").forEach((value, index) => params.set(levels[index], value));
            return `/posts/?${params}`;
        };

        const render = () => {
            const key = readKey();
            const path = key ? key.split("/") : [];
            const matching = posts.filter((post) =>
                path.every((value, index) => post.dataset[levels[index]] === value)
            );

            // Unfiltered: page through the list. Filtered: show every match.
            posts.forEach((post) => {
                const index = matching.indexOf(post);
                post.hidden = index === -1 || (!key && index >= limit);
                post.classList.remove("post-item-first-visible", "post-item-last-visible");
            });
            const visible = posts.filter((post) => !post.hidden);
            visible[0]?.classList.add("post-item-first-visible");
            visible[visible.length - 1]?.classList.add("post-item-last-visible");

            const remaining = key ? 0 : matching.length - limit;
            showMore.hidden = remaining <= 0;
            showMoreButton.textContent = `Show ${Math.min(pageSize, remaining)} more`;

            title.textContent = key ? path[path.length - 1] : defaultTitle;
            copy.textContent = key
                ? `${matching.length} ${matching.length === 1 ? "post" : "posts"}${path.length > 1 ? ` in ${path.slice(0, -1).join(" / ")}` : ""}`
                : defaultCopy;

            allLink.classList.toggle("is-active", !key);
            groups.forEach((group) => {
                const active = group.dataset.indexKey === key;
                group.querySelector(":scope > summary").classList.toggle("is-active", active);
                if (active || key.startsWith(group.dataset.indexKey + "/")) group.open = true;
            });
        };

        const go = (key) => {
            history.pushState(null, "", urlFor(key));
            limit = pageSize;
            rail.classList.remove("is-open");
            railToggle.setAttribute("aria-expanded", "false");
            render();
        };

        // Clicking a name filters the list; clicking the triangle only opens or closes.
        groups.forEach((group) => {
            const summary = group.querySelector(":scope > summary");
            summary.addEventListener("click", (event) => {
                if (event.target.closest(".post-index-toggle")) return;
                event.preventDefault();
                const key = group.dataset.indexKey;
                if (readKey() === key) {
                    group.open = !group.open;
                    return;
                }
                group.open = true;
                go(key);
            });
        });

        allLink.addEventListener("click", (event) => {
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
            event.preventDefault();
            go("");
        });

        window.addEventListener("popstate", render);

        showMoreButton.addEventListener("click", () => {
            limit += pageSize;
            render();
        });

        railToggle.addEventListener("click", () => {
            const open = rail.classList.toggle("is-open");
            railToggle.setAttribute("aria-expanded", String(open));
        });

        render();
    })();
</script>
