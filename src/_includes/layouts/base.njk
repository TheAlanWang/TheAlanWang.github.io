<!DOCTYPE html>
<html lang="en">
<head>
    {% set metaDescription = description or site.homeIntroText %}
    {% set metaTitle = (title + " | " + site.name) if title else site.name %}
    {% set canonicalUrl = site.url + (page.url or "/") %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ site.socialImage }}">
    <meta property="og:image:alt" content="{{ site.name }} preview image">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="627">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ metaTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ site.socialImage }}">
    <title>{{ metaTitle }}</title>
    <meta name="theme-color" content="#f3f4f1">
    <script>
        (function () {
            var root = document.documentElement;
            var meta = document.querySelector('meta[name="theme-color"]');
            var system = window.matchMedia("(prefers-color-scheme: dark)");
            var saved = null;
            try { saved = localStorage.getItem("theme"); } catch (e) {}

            window.setTheme = function (theme, remember) {
                root.dataset.theme = theme;
                meta.setAttribute("content", theme === "dark" ? "#0f1418" : "#f3f4f1");
                if (remember) {
                    saved = theme;
                    try { localStorage.setItem("theme", theme); } catch (e) {}
                }
            };

            window.setTheme(saved || (system.matches ? "dark" : "light"), false);
            system.addEventListener("change", function (event) {
                if (!saved) window.setTheme(event.matches ? "dark" : "light", false);
            });
        })();
    </script>
    <link rel="icon" href="/assets/favicon/Favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css?v={{ site.assetVersion }}">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <div class="page-shell{% if pageShellClass %} {{ pageShellClass }}{% endif %}">
        <header class="site-header">
            <a href="/" class="site-brand">{{ site.name }}</a>
            <nav class="site-nav" aria-label="Primary">
                <a href="/" class="site-nav-link{% if navKey == 'home' %} current{% endif %}">Home</a>
                <a href="/posts/" class="site-nav-link{% if navKey == 'posts' %} current{% endif %}">Posts</a>
                <a href="/about.html" class="site-nav-link{% if navKey == 'about' %} current{% endif %}">About Me</a>
            </nav>
            <button type="button" class="theme-toggle" data-theme-toggle role="switch" aria-checked="true" aria-label="Dark mode">
                <svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
                <span class="theme-toggle-knob"></span>
            </button>
        </header>
        {{ content | safe }}
    </div>
    <script>
        // When the page shows the large name, hide the header name until it scrolls away.
        (function () {
            var name = document.querySelector(".identity-title");
            var brand = document.querySelector(".site-brand");
            if (!name || !brand || !("IntersectionObserver" in window)) return;
            brand.classList.add("site-brand-deferred");
            new IntersectionObserver(function (entries) {
                brand.classList.toggle("is-visible", !entries[0].isIntersecting);
            }, { rootMargin: "-56px 0px 0px 0px" }).observe(name);
        })();
    </script>
    <script>
        (function () {
            var root = document.documentElement;
            var button = document.querySelector("[data-theme-toggle]");
            if (!button) return;
            function render() {
                button.setAttribute("aria-checked", String(root.dataset.theme === "dark"));
            }
            button.addEventListener("click", function (event) {
                event.stopPropagation();
                window.setTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
                render();
            });
            new MutationObserver(render).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
            render();
        })();
    </script>
</body>
</html>
