---
layout: layouts/base.njk
navKey: home
bodyClass: page-home
---
<script>
    try {
        if (sessionStorage.getItem("titleCardSeen") || matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.add("title-card-skip");
        }
    } catch (e) {}
</script>
<div class="title-card" aria-hidden="true">
    <p class="title-card-name">{{ site.name }}</p>
    <p class="title-card-line">{{ site.tagline }}</p>
</div>
<script>
    (function () {
        var card = document.querySelector(".title-card");
        if (!card || document.documentElement.classList.contains("title-card-skip")) return;
        try { sessionStorage.setItem("titleCardSeen", "1"); } catch (e) {}
        function skip() {
            card.classList.add("is-skipped");
            ["click", "keydown", "wheel", "touchstart"].forEach(function (type) {
                window.removeEventListener(type, skip);
            });
        }
        ["click", "keydown", "wheel", "touchstart"].forEach(function (type) {
            window.addEventListener(type, skip, { passive: true });
        });
    })();
</script>
<div class="layout-grid">
    <aside class="identity-rail">
        <div class="identity-block">
            <p class="eyebrow">Applied AI Engineer</p>
            <h1 class="identity-title">{{ site.name }}</h1>
            <p class="identity-summary">{{ site.tagline }}</p>
        </div>

        <div class="identity-meta">
            {% for fact in site.quickFacts %}
                <span class="meta-pill">{{ fact }}</span>
            {% endfor %}
        </div>
    </aside>

    <main class="content-column">
        <section class="lead-panel">
            <h2 class="lead-title">
                {% for line in site.homeIntroLines %}
                    <span class="lead-line">{{ line }}</span>{% if not loop.last %}<br>{% endif %}
                {% endfor %}
            </h2>
            <p class="lead-copy">{{ site.homeIntroText }}</p>
        </section>

        <section id="posts" class="content-section">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">{{ site.postsIntroTitle }}</p>
                    <h2 class="section-title">Recent writing and project notes.</h2>
                </div>
                {% if site.postsIntroText %}
                    <p class="section-description">{{ site.postsIntroText }}</p>
                {% endif %}
            </div>

            <div class="section-footer-link section-footer-link-top no-divider">
                <a href="/posts/" class="browse-link">Browse all posts</a>
            </div>

            <div class="list-stream">
                {% for post in collections.recentPosts %}
                    <article class="stream-item post-item">
                        <div class="stream-copy">
                            <div class="stream-meta">
                                <span class="stream-topic">{{ post.data.category }}</span>
                                <span class="stream-subtopic">{{ post.data.subcategory }}</span>
                                <span class="stream-date">{{ post.date | displayDate }}</span>
                            </div>
                            <h3 class="stream-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                            <p class="stream-excerpt">{{ post.data.excerpt }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section id="contact" class="content-section">
            <div class="section-heading">
                <div>
                    <h2 class="section-title">Contact</h2>
                </div>
            </div>

            <div class="contact-panel">
                <p class="contact-copy">{{ site.contact.blurb }}</p>
                <div class="contact-links">
                    {% for link in site.contact.links %}
                        <a href="{{ link.url }}"
                           {% if link.external %}target="_blank" rel="noreferrer"{% endif %}
                           class="contact-link">
                            {{ link.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>

        {% include "partials/site-footer.njk" %}
    </main>
</div>
